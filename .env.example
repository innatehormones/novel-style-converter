# .env — 启动时 (nsc-desktop) 由 dotenvy 读取。
# 用途:model_configs 表为空时,作为兜底自动插入一条记录(便于首次启动就能用)。
# 已存在用户配置时不会覆盖。任一必填项缺失即跳过整条 seed。
#
# 复制本文件为 .env 并填值;真 api_key 请直接编辑 .env,
# 不要把含真 key 的 .env 提交到仓库(.gitignore 已排除)。
#
# 必填(任一缺失即不 seed)
NSC_DEFAULT_MODEL_NAME=env-default
NSC_DEFAULT_MODEL_BASE_URL=https://api.deepseek.com/v1
NSC_DEFAULT_MODEL_API_KEY=sk-placeholder-edit-me
NSC_DEFAULT_MODEL_MODEL=deepseek-chat

# 可选
# NSC_DEFAULT_MODEL_MAX_TOKENS=4096
# NSC_DEFAULT_MODEL_TEMPERATURE=0.7
# NSC_DEFAULT_MODEL_CONCURRENCY=3
